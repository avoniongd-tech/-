PORT=3000
DEMO_MODE=true
MAX_REQUESTS_PER_10_MIN=30

# Admin account: create a hash with: node -e "console.log(require('crypto').scryptSync('CHANGE_ME','vk-admin-salt',64).toString('hex'))"
